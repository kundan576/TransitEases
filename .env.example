# TransitEase Environment Configuration Template
# Copy this file to .env for local runtime configuration
# NEVER commit your real database passwords to version control

# APP RUNTIME
PORT=3000
NODE_ENV=development
APP_URL="https://transitease.city"
JWT_SECRET="transitease_super_secure_jwt_secret_token_2026"

# MONGODB ATLAS CONNECTION
# Provide your MongoDB Atlas connection string below in your private .env file:
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/transitease?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/transitease?retryWrites=true&w=majority"
REQUIRE_MONGODB="true"

# SMS GATEWAY INTEGRATION (Fast2SMS / Twilio / MSG91)
# Note: Real SMS sending is currently disabled to prevent blocking core transit workflows
SMS_PROVIDER="simulator"
SMS_API_KEY="YOUR_SMS_API_KEY_HERE"
SMS_SENDER_ID="TRNEAS"

# WEB PUSH NOTIFICATION KEYS (VAPID)
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuTlUhFsGEgo2q88V0UnqdTXgw"
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@transitease.city"
